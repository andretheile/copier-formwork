name: Security

on:
  pull_request:
    branches: [{% if integration_branch == 'dev' %}dev, main{% else %}main{% endif %}]
  schedule:
    - cron: "0 4 * * 1"

jobs:
  pip-audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
        with:
          python-version: "{{ python_version }}"
      - run: uv sync --extra dev
      - run: uvx pip-audit

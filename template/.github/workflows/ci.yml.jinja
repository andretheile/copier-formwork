name: CI

on:
  pull_request:
    branches: [{% if integration_branch == 'dev' %}dev, main{% else %}main{% endif %}]
  push:
    branches: [{% if integration_branch == 'dev' %}dev, main{% else %}main{% endif %}]

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
        with:
          python-version: "{{ python_version }}"
      - run: uv sync --extra dev
      - run: uv run ruff format --check src tests
      - run: uv run ruff check src tests
      - run: uv run pytest

  target-branch:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - name: Feature PRs must target {{ integration_branch }}
        env:
          BASE: {% raw %}${{ github.base_ref }}{% endraw %}
          HEAD: {% raw %}${{ github.head_ref }}{% endraw %}
        run: |
          set -euo pipefail
          integration="{{ integration_branch }}"
          if [ "$integration" = "dev" ] && [ "$BASE" = "main" ] && [ "$HEAD" != "dev" ]; then
            echo "Open this pull request against dev, not main (unless merging dev into main)."
            exit 1
          fi

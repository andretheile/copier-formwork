```mermaid
flowchart LR
  {% if kind == 'service' %}
  {% if frontend == 'vite' %}
  ui[frontend api.ts] --> http[adapters/http]
  {% else %}
  req[HTTP request] --> http[adapters/http]
  {% endif %}
  http --> domain[domain]
  {% if database == 'postgres' %}

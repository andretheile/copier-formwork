from fastapi import APIRouter, HTTPException

from {{ package_name }}.settings import is_ready

router = APIRouter()


@router.get("/health")
def health() -> dict[str, str]:
    return {"status": "ok"}


@router.get("/ready")
def ready() -> dict[str, str]:
    if not is_ready():
        raise HTTPException(status_code=503, detail="database unavailable")
    return {"status": "ok"}
